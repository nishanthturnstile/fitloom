{
  "name": "@fitloom/application",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js"
    },
    "./workspace-contracts": {
      "types": "./dist/workspace-contracts.d.ts",
      "default": "./dist/workspace-contracts.js"
    },
    "./master-contracts": {
      "types": "./dist/master-contracts.d.ts",
      "default": "./dist/master-contracts.js"
    },
    "./garment-definition": {
      "types": "./dist/garment-definition.d.ts",
      "default": "./dist/garment-definition.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --filter @fitloom/db build && pnpm build && node --env-file-if-exists=../db/.env --test --test-concurrency=1 test/*.test.mjs",
    "mail:local": "node ../../scripts/compose.mjs up",
    "mail:status": "node --env-file-if-exists=../db/.env scripts/mail-status.mjs",
    "test:http": "node --env-file-if-exists=../db/.env scripts/web-smoke.mjs && node --env-file-if-exists=../db/.env scripts/master-transport-check.mjs",
    "test:storage-reset": "node --env-file-if-exists=../db/.env scripts/reset-test-storage.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@better-auth/drizzle-adapter": "1.7.14",
    "@fitloom/db": "workspace:*",
    "better-auth": "1.7.14",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.4",
    "nodemailer": "10.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  }
}
