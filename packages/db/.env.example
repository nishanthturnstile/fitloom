# db:local generates packages/db/.env with separate random local credentials.
# Never give application processes migration, test, or administrator URLs.
MIGRATOR_DATABASE_URL=postgresql://fitloom_dev_migrator:replace@127.0.0.1:24430/fitloom_dev
WEB_DATABASE_URL=postgresql://fitloom_dev_web:replace@127.0.0.1:24430/fitloom_dev
WORKER_DATABASE_URL=postgresql://fitloom_dev_worker:replace@127.0.0.1:24430/fitloom_dev
AUTH_DATABASE_URL=postgresql://fitloom_dev_auth:replace@127.0.0.1:24430/fitloom_dev
OPERATOR_DATABASE_URL=postgresql://fitloom_dev_operator:replace@127.0.0.1:24430/fitloom_dev
TEST_MIGRATOR_DATABASE_URL=postgresql://fitloom_test_migrator:replace@127.0.0.1:24430/fitloom_test
TEST_WEB_DATABASE_URL=postgresql://fitloom_test_web:replace@127.0.0.1:24430/fitloom_test
TEST_WORKER_DATABASE_URL=postgresql://fitloom_test_worker:replace@127.0.0.1:24430/fitloom_test
TEST_AUTH_DATABASE_URL=postgresql://fitloom_test_auth:replace@127.0.0.1:24430/fitloom_test
TEST_OPERATOR_DATABASE_URL=postgresql://fitloom_test_operator:replace@127.0.0.1:24430/fitloom_test
