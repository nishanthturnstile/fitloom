# syntax=docker/dockerfile:1
FROM node:26.13.0-bookworm-slim@sha256:bc0a2afd3b74ce12222fc8bab99271e66257f021078f5f4a5d687a77d280c1d9
RUN npm install --global pnpm@12.16.1
RUN mkdir -p /var/lib/fitloom/private-files && chown node:node /var/lib/fitloom/private-files
WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/package.json
COPY apps/worker/package.json ./apps/worker/package.json
COPY packages/application/package.json ./packages/application/package.json
COPY packages/db/package.json ./packages/db/package.json
RUN --mount=type=cache,id=fitloom-pnpm,target=/pnpm/store pnpm install --frozen-lockfile --store-dir=/pnpm/store && chown -R node:node /workspace
COPY --chown=node:node . .
# Recovery tools use the host UID for private bind-mounted artifacts.
COPY --chown=node:node --chmod=0644 pnpm-lock.yaml ./
USER node
RUN pnpm --filter @fitloom/db build && pnpm --filter @fitloom/application build
ENV NEXT_TELEMETRY_DISABLED=1 TURBO_TELEMETRY_DISABLED=1
