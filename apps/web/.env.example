# Compose generates .local/web.env; this example documents the web service variables.
FITLOOM_ENV=development
LOG_LEVEL=info
WEB_DATABASE_URL=postgresql://fitloom_dev_web:replace@127.0.0.1:24430/fitloom_dev
AUTH_DATABASE_URL=postgresql://fitloom_dev_auth:replace@127.0.0.1:24430/fitloom_dev
AUTH_BASE_URL=https://your-mac.your-tailnet.ts.net:24443
AUTH_TRUSTED_ORIGINS=https://your-mac.your-tailnet.ts.net:24443
AUTH_SECRET=replace-with-a-generated-secret-of-at-least-32-characters
MAIL_ENCRYPTION_KEY=replace-with-a-separate-generated-key-of-at-least-32-characters
MAIL_PROVIDER=mailpit
MAILPIT_PUBLIC_URL=https://your-mac.your-tailnet.ts.net:24444
# AUTH_PROXY_HEADER is unset locally. Set only behind a trusted proxy that replaces it.
# Production: FITLOOM_ENV=production, MAIL_PROVIDER=resend, HTTPS origins.
# The Resend API key belongs only to the mail worker.

# Development/test signed fixture inbox only. Compose generates a separate key.
FIXTURE_INBOX_ENABLED=false
# FIXTURE_INBOX_SECRET=at-least-32-private-characters

# SeaweedFS S3-compatible storage; Compose generates distinct bucket-scoped credentials.
STORAGE_ENDPOINT=http://seaweedfs:24453
STORAGE_BUCKET=fitloom-dev
STORAGE_ACCESS_KEY=replace-with-the-service-specific-generated-access-key
STORAGE_SECRET_KEY=replace-with-the-service-specific-generated-secret-key
