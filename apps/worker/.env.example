# Compose generates .local/worker.env. No auth signing secret is needed here.
FITLOOM_ENV=development
LOG_LEVEL=info
WORKER_DATABASE_URL=postgresql://fitloom_dev_worker:replace@127.0.0.1:24430/fitloom_dev
MAIL_ENCRYPTION_KEY=replace-with-the-same-mail-key-used-by-the-web-app
MAIL_PROVIDER=mailpit
MAILPIT_HOST=mailpit
MAILPIT_SMTP_PORT=24421
MAIL_FROM=fitloom@example.test
# Production: FITLOOM_ENV=production, MAIL_PROVIDER=resend,
# MAIL_FROM=address@your-verified-domain, RESEND_API_KEY supplied privately.
# Resend uses SMTP over TLS on smtp.resend.com:465.

# Private Compose volume; never serve this directory as public assets.
FILE_STAGING_ROOT=/var/lib/fitloom/private-files

# SeaweedFS S3-compatible storage; Compose generates distinct bucket-scoped credentials.
STORAGE_ENDPOINT=http://seaweedfs:24453
STORAGE_BUCKET=fitloom-dev
STORAGE_ACCESS_KEY=replace-with-the-service-specific-generated-access-key
STORAGE_SECRET_KEY=replace-with-the-service-specific-generated-secret-key
